<?xml version="1.0" encoding="utf-8"?>
<configuration>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/></startup>

  <connectionStrings>
    <add name="Entities_dbcore" 
		 connectionString="metadata=res://*/core_db.csdl|res://*/core_db.ssdl|res://*/core_db.msl;
		 provider=System.Data.SqlClient;
		 provider connection string=&quot;
		 data source=DESKTOP-UPP3DBT;     
		  initial catalog=dbcore;  
		   Trusted_Connection=Yes;
		  persist security info=True; 
		 MultipleActiveResultSets=True;
		 App=EntityFramework&quot;" 
		 providerName="System.Data.EntityClient" />
  </connectionStrings>
<appSettings>
  <add key="horaInicio" value="3"/>
</appSettings>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IConsultaCFDIService">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="https://consultaqr.facturaelectronica.sat.gob.mx/ConsultaCFDIService.svc"
          binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IConsultaCFDIService"
          contract="EstatusSAT.IConsultaCFDIService" name="BasicHttpBinding_IConsultaCFDIService" />
    </client>
  </system.serviceModel>
</configuration>
