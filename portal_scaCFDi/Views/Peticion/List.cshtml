@model portal_scaCFDi.Models.PeticionViewModels.ListViewModels
@{
    ViewBag.Title = "Listado de peticiones";
    ViewBag.Encabezado = Model.nombre_cliente;
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-12">
        <h2>@ViewBag.Title.</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Inicio</a>
            </li>
            <li>
                <a href="@Url.Action("List", "Cliente")">Contribuyentes</a>
            </li>
            <li>
                <strong>Peticiones </strong>
            </li>
        </ol>
    </div>

</div>

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-content">

                    <table width="99%">
                        <tr>
                            <td>
                                @Html.ActionLink("Listado de clientes", "List", "Cliente", new { }, new { @class = "btn btn-success" })

                            </td>

                            <td style="text-align:right">
                                <button class="btn btn-success" onclick="recarga();">Actualizar registros</button>
                                @Html.ActionLink("Crear petición", "Create", new { }, new { @class = "btn btn-success" })
                            </td>
                        </tr>
                    </table>
                    @using (Html.BeginForm("List", "Peticion", FormMethod.Post, new { method = "post" }))
                    {

                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(Model => Model.idCliente)
                        <table width="60%">
                            <tr>
                                <td width="10%" class="text-center"><label>Año:</label></td>
                                <td width="10%" class="text-center">
                                    <select class="form-control m-b" name="anio">
                                        @for (var i = 2017; i <= DateTime.Now.Year; i++)
                                        {
                                            if (Model.anio == i)
                                            {
                                                <option value="@i" selected="true">@i</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        }
                                    </select>

                                </td>
                                <td width="10%" class="text-center"><label>Mes:</label></td>
                                <td width="30%" class="text-center">
                                    <select class="form-control m-b" name="mes">
                                        @if (Model.mes == 1)
                                        {
                                            <option value="1" selected="true">Enero</option>
                                        }
                                        else
                                        {
                                            <option value="1">Enero</option>
                                        }
                                        @if (Model.mes == 2)
                                        {
                                            <option value="2" selected="true">Febrero</option>
                                        }
                                        else
                                        {
                                            <option value="2">Febrero</option>
                                        }
                                        @if (Model.mes == 3)
                                        {
                                            <option value="3" selected="true">Marzo</option>
                                        }
                                        else
                                        {
                                            <option value="3">Marzo</option>
                                        }
                                        @if (Model.mes == 4)
                                        {
                                            <option value="4" selected="true">Abril</option>
                                        }
                                        else
                                        {
                                            <option value="4">Abril</option>
                                        }
                                        @if (Model.mes == 5)
                                        {
                                            <option value="5" selected="true">Mayo</option>
                                        }
                                        else
                                        {
                                            <option value="5">Mayo</option>
                                        }
                                        @if (Model.mes == 6)
                                        {
                                            <option value="6" selected="true">Junio</option>
                                        }
                                        else
                                        {
                                            <option value="6">Junio</option>
                                        }
                                        @if (Model.mes == 7)
                                        {
                                            <option value="7" selected="true">Julio</option>
                                        }
                                        else
                                        {
                                            <option value="7">Julio</option>
                                        }
                                        @if (Model.mes == 8)
                                        {
                                            <option value="8" selected="true">Agosto</option>
                                        }
                                        else
                                        {
                                            <option value="8">Agosto</option>
                                        }
                                        @if (Model.mes == 9)
                                        {
                                            <option value="9" selected="true">Septiembre</option>
                                        }
                                        else
                                        {
                                            <option value="9">Septiembre</option>
                                        }
                                        @if (Model.mes == 10)
                                        {
                                            <option value="10" selected="true">Octubre</option>
                                        }
                                        else
                                        {
                                            <option value="10">Octubre</option>
                                        }
                                        @if (Model.mes == 11)
                                        {
                                            <option value="11" selected="true">Noviembre</option>
                                        }
                                        else
                                        {
                                            <option value="11">Noviembre</option>
                                        }
                                        @if (Model.mes == 12)
                                        {
                                            <option value="12" selected="true">Diciembre</option>
                                        }
                                        else
                                        {
                                            <option value="12">Diciembre</option>
                                        }


                                    </select>

                                </td>
                                <td width="10%" class="text-center"><label>Día:</label></td>
                                <td width="10%" class="text-center">
                                    <select class="form-control m-b" name="dia">
                                        @for (var i = 0; i <= 31; i++)
                                        {
                                            if (Model.dia == i)
                                            {
                                                <option value="@i" selected="true">@i</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i</option>
                                            }

                                        }
                                    </select>

                                </td>
                                <td width="20%" class="text-center">
                                    <input type="submit" value="Filtrar" class="btn btn-success" />
                                </td>
                            </tr>
                        </table>
                    }
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>

                                <th>Fecha de creación</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Emitido</th>
                                <th>Error</th>
                                <th>Número de XML </th>
                                <th>Tipo</th>
                                <th>Terminado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model.Listado)
                            {
                                <tr>
                                    <td>@item.fechaCreacion</td>
                                    <td>@item.inicio</td>
                                    <td>@item.fin</td>
                                    <td>@item.Emitido</td>
                                    <td>@item.error</td>
                                    <td>
                                        @if (item.numxml != "0")
                                        {
                                            <a href="@Url.Action("List_peticion","cfdi", new { idpeticion = item.id})"> @item.numxml&nbsp;<i class="fa fa-file-o"></i></a>
                                        }
                                        else
                                        {
                                            @item.numxml
                                        }
                                    </td>
                                    <td>@item.modalidad</td>
                                    <td>@item.terminado</td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Styles {
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")

    <script type="text/javascript">
        $(document).ready(function () {

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                language: {
                    url: '../Scripts/plugins/dataTables/es_es.json'
                },
                buttons: [
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },

                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]

            });



        });

        function recarga() {
            location.reload();
        }

    </script>
}