@{
    ViewBag.Title = "Administrador de archivos";
}

<h2>@ViewBag.Title.</h2>


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <p class="text-right">

                <div class="file-box">
                    <div class="file">
                        <a href="/programas/Download?fileName=ToPFX&tipo=.zip">
                            <span class="corner"></span> <div class="icon"><i class="fa fa-folder"></i> </div>
                            <div class="file-name"> ToPFX.zip <br> <small>Agregado: Ago 12, 2021</small></div>
                        </a>
                    </div>
                </div>
                <div class="file-box">
                    <div class="file">
                        <a href="/programas/Download?fileName=CDCFDI&tipo=.zip">
                            <span class="corner"></span> <div class="icon"><i class="fa fa-folder"></i> </div>
                            <div class="file-name">  CDCFDI.zip <br> <small>Agregado: Ago 12, 2021</small></div>
                        </a>
                    </div>
                </div>
            </p>
        </div>
    </div>
</div>
