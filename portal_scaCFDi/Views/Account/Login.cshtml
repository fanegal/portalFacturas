@model portal_scaCFDi.Models.LoginViewModel

@{
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SCA_DCFDI | Acceso</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link href="~/Fonts/font-awesome/css/font-awesome.css" rel="stylesheet">

    <link href="~/Content/animate.css" rel="stylesheet">
    <link href="~/Content/style.css" rel="stylesheet">

    <style>
        body {
            background-size: 100% 100%;
            background-image: url("/imagenes/login-2.jpg");
            background-repeat: no-repeat;
            background-attachment: fixed
        }

        #divlogin {
            border-radius: 22px 22px 22px 22px;
        }
    </style>

</head>
<body class="gray-bg s-skin-0">

    <div class="loginColumns animated fadeInDown">
        <div class="row">

            <div class="col-md-6">
                <h2 class="font-bold">Bienvenidos</h2>
                <p></p>


            </div>
            <div class="col-md-6">
                <div id="divlogin" class="ibox-content">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        <h3 class="font-bold text-center">Acceso</h3>
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Correo Electronico" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            <!--  <input type="email" class="form-control" required="">-->
                        </div>
                        <div class="form-group">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Constraseña" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            <!--  <input type="password" class="form-control"  required="">-->
                        </div>
                        <button type="submit" class="btn btn-success block full-width m-b">Entrar</button>

                        <div class="form-group">
                            <div class="col-lg-12 text-muted text-center">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.RememberMe)
                            </div> 
                        </div>

                        <p class="text-muted text-center">
                            @Html.ActionLink("Registrarse como usuario nuevo", "Register")
                        </p>

                        <p class="text-muted text-center">
                            @Html.ActionLink("¿Olvido su contaseña?", "ForgotPassword")
                        </p>
                    }

                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                Servicios Computacionales Arteaga
            </div>
            <div class="col-md-6 text-right">
                <small> &copy; @DateTime.Now.Year </small>
            </div>
        </div>
    </div>

</body>
</html>




