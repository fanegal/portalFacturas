@{
    ViewBag.Title = "Confirmar correo electrónico";
}



@{
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SCA_DCFDI | Registrarse</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link href="~/Fonts/font-awesome/css/font-awesome.css" rel="stylesheet">

    <link href="~/Content/animate.css" rel="stylesheet">
    <link href="~/Content/style.css" rel="stylesheet">

    <style>
        body {
            background-color: #5DA9B7;
        }

        #divlogin {
            border-radius: 22px 22px 22px 22px;
        }
    </style>

</head>
<body>
    <h2>@ViewBag.Title.</h2>
    <div class="loginColumns animated fadeInDown">
        <div class="row">
            <div class="col-md-12">
                <div id="divlogin" class="ibox-content">
                    <div>
                        <p>
                            Gracias por confirmar tu correo electrónico. Por favor @Html.ActionLink("Click para iniciar sesion", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
                        </p>
                    </div>

                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                Servicios Computacionales Arteaga
            </div>
            <div class="col-md-6 text-right">
                <small> &copy; @DateTime.Now.Year </small>
            </div>
        </div>
    </div>

</body>
</html>




